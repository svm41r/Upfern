{
  "manifest_version": 3,
  "name": "Upfern — 4-Platform Social Auto Poster",
  "version": "2.1.1",
  "description": "Connects Upfern to YouTube Shorts, TikTok, Instagram Reels, and Facebook Reels: exports clips to Documents and auto-publishes in 1 click.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Upfern",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8767/*",
    "http://localhost:8767/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://business.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "content/common.js",
        "content/youtube.js"
      ],
      "css": [
        "content/hud.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio*",
        "https://www.tiktok.com/creator-center*",
        "https://www.tiktok.com/upload*"
      ],
      "js": [
        "content/common.js",
        "content/tiktok.js"
      ],
      "css": [
        "content/hud.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content/common.js",
        "content/instagram.js"
      ],
      "css": [
        "content/hud.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/reels/create*",
        "https://www.facebook.com/reel/create*",
        "https://business.facebook.com/latest/reels_composer*"
      ],
      "js": [
        "content/common.js",
        "content/facebook.js"
      ],
      "css": [
        "content/hud.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8767/*",
        "http://localhost:8767/*"
      ],
      "js": [
        "content/app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
